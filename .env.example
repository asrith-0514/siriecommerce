# ==============================================================================
# Siri Shopping Mall - Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real configuration.
# NEVER commit .env to version control or expose production credentials.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/siri-dev?retryWrites=true&w=majority
MONGODB_DB=siri-dev

# Server Session & Cookie Security
# A secure, high-entropy 64+ character random string used for session cookie integrity
SESSION_SECRET=replace_with_a_64_character_random_hex_string_for_production

# Optional / Future Gateway Keys (Phase 2H - Payment Integration)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
